# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Agora Conversational AI Engine (required for voice) ---------------------------------
# Agora Console → your project. Enable Conversational AI for the project and turn on the
# App Certificate. These never reach the browser; the App ID is returned by the API per session.
# (The names NEXT_PUBLIC_AGORA_APP_ID / NEXT_AGORA_APP_CERTIFICATE used by Agora's official
# quickstart are also accepted.)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Written feedback after each interview (optional, recommended) -----------------------
# Without this the app still runs interviews; the report step just offers the transcript.
ANTHROPIC_API_KEY=

# --- Protecting a public deployment (optional, recommended) ------------------------------
# Every session spends real money (Agora minutes + speech + LLM). If set, visitors must enter
# this code before they can start an interview or request feedback.
COACH_ACCESS_CODE=

# --- Tuning (optional) -------------------------------------------------------------------
# Agora-managed interviewer LLM: gpt-4.1-mini (default) or gpt-4o-mini
# COACH_LLM_MODEL=gpt-4.1-mini
# MiniMax voice id for the interviewer
# COACH_TTS_VOICE_ID=English_captivating_female1
# Model that writes the feedback report (default claude-opus-5; claude-sonnet-5 is faster/cheaper)
# COACH_FEEDBACK_MODEL=claude-opus-5
