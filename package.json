    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "agora-agent-client-toolkit": "^2.10.0",
    "agora-agents": "^2.10.0",
    "agora-rtc-react": "^2.5.1",
    "agora-rtc-sdk-ng": "^4.24.8",
    "agora-rtm": "^2.3.0",
    "agora-token": "^2.0.6",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
