{
  "name": "career-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first mock interview coach for engineers, built on Agora's Conversational AI Engine",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
